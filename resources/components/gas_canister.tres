[resource]
script = ExtResource("1")
id = "gas_canister"
display_name = "Gas Canister"
description = "A generic compressed gas canister for mixed gasses at high pressure (Ostranauts), for temporary and waste gas storage. Place it right next to a CO₂ or Contaminant AtmoScrubber: the scrubber pumps what it removes into it. Without a canister, or with a full one, scrubbers vent overboard and wear twice as fast. Empty it at a station's Docking and Refuel Services, or vent it where it touches open space (right-click). Holds 300 kPa."
